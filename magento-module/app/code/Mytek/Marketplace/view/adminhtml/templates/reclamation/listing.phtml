<?php
/** @var \Mytek\Marketplace\Block\Adminhtml\Reclamation\Listing $block */
/** @var \Magento\Framework\Escaper $escaper */
$list        = $block->getReclamations();
$unseenOnly  = $block->isUnseenOnly();
$unseenCount = $block->getUnseenCount();
?>
<div class="mk-toolbar">
    <div class="mk-tabs">
        <a href="<?= $escaper->escapeUrl($block->getFilterUrl(false)) ?>" class="<?= !$unseenOnly ? 'active' : '' ?>"><?= $escaper->escapeHtml(__('All')) ?></a>
        <a href="<?= $escaper->escapeUrl($block->getFilterUrl(true)) ?>" class="<?= $unseenOnly ? 'active' : '' ?>">
            <?= $escaper->escapeHtml(__('Unread')) ?>
            <?php if ($unseenCount > 0): ?><span class="mk-badge mk-badge--new"><?= (int)$unseenCount ?></span><?php endif; ?>
        </a>
    </div>
    <div class="mk-readonly"><?= $escaper->escapeHtml(__('%1 claim(s)', count($list))) ?></div>
</div>

<div class="admin__data-grid-wrap">
    <table class="data-grid">
        <thead>
        <tr>
            <th class="data-grid-th">#</th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Seller')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Shop')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Status')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('New message')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Created on')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Last activity')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Action')) ?></th>
        </tr>
        </thead>
        <tbody>
        <?php if (!$list): ?>
            <tr><td colspan="8" class="empty-text"><?= $escaper->escapeHtml(__('No claim.')) ?></td></tr>
        <?php else: ?>
            <?php foreach ($list as $r): ?>
                <?php $type = (int)$r['type']; $isNew = (int)$r['admin_viewed'] === 0 && $type === 1; ?>
                <tr>
                    <td>#<?= (int)$r['id'] ?></td>
                    <td><?= $escaper->escapeHtml(trim(($r['firstname'] ?? '') . ' ' . ($r['lastname'] ?? '')) ?: '—') ?></td>
                    <td><?= $escaper->escapeHtml((string)($r['shop_title'] ?? '—')) ?></td>
                    <td><span class="<?= $escaper->escapeHtmlAttr($block->typeClass($type)) ?>"><?= $escaper->escapeHtml($block->typeLabel($type)) ?></span></td>
                    <td><?php if ($isNew): ?><span class="mk-badge mk-badge--new"><?= $escaper->escapeHtml(__('New')) ?></span><?php else: ?>—<?php endif; ?></td>
                    <td><?= $escaper->escapeHtml($block->formatDateTime($r['created_at'] ?? null)) ?></td>
                    <td><?= $escaper->escapeHtml($block->formatDateTime($r['updated_at'] ?? null)) ?></td>
                    <td><a class="action-default" href="<?= $escaper->escapeUrl($block->getViewUrl((int)$r['id'])) ?>"><?= $escaper->escapeHtml(__('View conversation')) ?></a></td>
                </tr>
            <?php endforeach; ?>
        <?php endif; ?>
        </tbody>
    </table>
</div>
