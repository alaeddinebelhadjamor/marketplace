<?php
/** @var \Mytek\Marketplace\Block\Adminhtml\Dashboard $block */
/** @var \Magento\Framework\Escaper $escaper */
$k      = $block->getKpis();
$c      = $block->getSellerCounts();
$unseen = $block->getUnseenReclamations();
$sort   = $block->getSort();
$top    = $block->getTopSellers();
?>
<div class="mk-toolbar">
    <div class="mk-readonly"><?= $escaper->escapeHtml(__('Data consolidated from the marketplace database (orders synchronised from Magento).')) ?></div>
    <a class="action-default action-primary" href="<?= $escaper->escapeUrl($block->getExportUrl()) ?>"><?= $escaper->escapeHtml(__('Export to Excel (CSV)')) ?></a>
</div>

<div class="mk-kpis">
    <div class="mk-kpi mk-kpi--blue">
        <div class="mk-kpi__label"><?= $escaper->escapeHtml(__('Total orders')) ?></div>
        <div class="mk-kpi__value"><?= $escaper->escapeHtml(number_format($k['orders'], 0, ',', ' ')) ?></div>
    </div>
    <div class="mk-kpi mk-kpi--green">
        <div class="mk-kpi__label"><?= $escaper->escapeHtml(__('Active sellers')) ?></div>
        <div class="mk-kpi__value"><?= (int)$k['active_sellers'] ?></div>
        <?php if ($c[0] > 0): ?>
            <div class="mk-kpi__hint">
                <a href="<?= $escaper->escapeUrl($block->getPendingUrl()) ?>"><?= $escaper->escapeHtml(__('%1 registration(s) awaiting approval', (int)$c[0])) ?></a>
            </div>
        <?php endif; ?>
    </div>
    <div class="mk-kpi mk-kpi--orange">
        <div class="mk-kpi__label"><?= $escaper->escapeHtml(__('Total revenue')) ?></div>
        <div class="mk-kpi__value"><?= $escaper->escapeHtml($block->money($k['revenue'])) ?></div>
    </div>
    <div class="mk-kpi mk-kpi--grey">
        <div class="mk-kpi__label"><?= $escaper->escapeHtml(__('Items sold')) ?></div>
        <div class="mk-kpi__value"><?= $escaper->escapeHtml(number_format($k['items'], 0, ',', ' ')) ?></div>
    </div>
</div>

<?php if ($unseen > 0): ?>
    <p class="mk-readonly">
        <a href="<?= $escaper->escapeUrl($block->getReclamationsUrl()) ?>"><?= $escaper->escapeHtml(__('%1 unread claim(s)', $unseen)) ?></a>
    </p>
<?php endif; ?>

<div class="mk-section-title">
    <h2><?= $escaper->escapeHtml(__('Top sellers')) ?></h2>
    <div class="mk-tabs">
        <a href="<?= $escaper->escapeUrl($block->getSortUrl('revenue')) ?>" class="<?= $sort === 'revenue' ? 'active' : '' ?>"><?= $escaper->escapeHtml(__('By revenue')) ?></a>
        <a href="<?= $escaper->escapeUrl($block->getSortUrl('orders')) ?>" class="<?= $sort === 'orders' ? 'active' : '' ?>"><?= $escaper->escapeHtml(__('By orders')) ?></a>
    </div>
</div>

<div class="admin__data-grid-wrap">
    <table class="data-grid">
        <thead>
        <tr>
            <th class="data-grid-th">#</th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Seller')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Shop')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Email')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Orders')) ?></th>
            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Revenue')) ?></th>
        </tr>
        </thead>
        <tbody>
        <?php if (!$top): ?>
            <tr><td colspan="6" class="empty-text"><?= $escaper->escapeHtml(__('No sale recorded yet.')) ?></td></tr>
        <?php else: ?>
            <?php foreach ($top as $i => $row): ?>
                <tr>
                    <td><?= (int)$i + 1 ?></td>
                    <td><?= $escaper->escapeHtml(trim(($row['firstname'] ?? '') . ' ' . ($row['lastname'] ?? '')) ?: (string)__('Seller #%1', (int)$row['vendor_id'])) ?></td>
                    <td><?= $escaper->escapeHtml((string)($row['shop_title'] ?? '—')) ?></td>
                    <td><?= $escaper->escapeHtml((string)($row['email'] ?? '—')) ?></td>
                    <td><?= (int)$row['orders'] ?></td>
                    <td><?= $escaper->escapeHtml($block->money((float)$row['revenue'])) ?></td>
                </tr>
            <?php endforeach; ?>
        <?php endif; ?>
        </tbody>
    </table>
</div>
