<?php
/** @var \Mytek\Marketplace\Block\Adminhtml\Seller\Form $block */
/** @var \Magento\Framework\Escaper $escaper */
$s = $block->getSeller();
$governorates = $block->getGovernorates();
$currentGov = $block->value('governorate');
if ($currentGov !== '' && !in_array($currentGov, $governorates, true)) {
    $governorates[] = $currentGov;
}
$textFields = [
    'firstname'      => [__('First name'), true, 'text'],
    'lastname'       => [__('Last name'), true, 'text'],
    'email'          => [__('Email'), true, 'email'],
    'contact_number' => [__('Phone'), true, 'text'],
    'shop_title'     => [__('Shop name'), true, 'text'],
    'company'        => [__('Company'), false, 'text'],
    'address'        => [__('Address'), false, 'text'],
    'zipcode'        => [__('Postcode'), false, 'text'],
    'tax_id'         => [__('Tax ID'), false, 'text'],
];
?>
<form method="post" action="<?= $escaper->escapeUrl($block->getSaveUrl()) ?>" class="mk-form">
    <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>

    <fieldset class="admin__fieldset">
        <legend class="admin__legend"><span><?= $escaper->escapeHtml(__('Seller information')) ?></span></legend>
        <p class="mk-readonly">
            <?= $escaper->escapeHtml(__(
                'ID #%1 — Status: %2 — Registered on %3 (the status is changed from the seller list; the password is never editable here)',
                (int)($s['seller_id'] ?? 0),
                $block->statusLabel(),
                (string)($s['created_at'] ?? '')
            )) ?>
        </p>

        <div class="mk-grid-2">
            <?php foreach ($textFields as $name => [$label, $required, $type]): ?>
                <div class="admin__field <?= $required ? '_required' : '' ?>">
                    <label class="admin__field-label" for="mk-<?= $escaper->escapeHtmlAttr($name) ?>"><span><?= $escaper->escapeHtml($label) ?></span></label>
                    <div class="admin__field-control">
                        <input type="<?= $escaper->escapeHtmlAttr($type) ?>" id="mk-<?= $escaper->escapeHtmlAttr($name) ?>" name="seller[<?= $escaper->escapeHtmlAttr($name) ?>]"
                               class="admin__control-text" <?= $required ? 'required' : '' ?>
                               value="<?= $escaper->escapeHtmlAttr($block->value($name)) ?>"/>
                    </div>
                </div>
            <?php endforeach; ?>

            <div class="admin__field">
                <label class="admin__field-label" for="mk-governorate"><span><?= $escaper->escapeHtml(__('Governorate')) ?></span></label>
                <div class="admin__field-control">
                    <select id="mk-governorate" name="seller[governorate]" class="admin__control-select">
                        <option value=""><?= $escaper->escapeHtml(__('— Not specified —')) ?></option>
                        <?php foreach ($governorates as $g): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($g) ?>" <?= $g === $currentGov ? 'selected' : '' ?>><?= $escaper->escapeHtml($g) ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
            </div>

            <div class="admin__field">
                <label class="admin__field-label" for="mk-has_patent"><span><?= $escaper->escapeHtml(__('Business licence')) ?></span></label>
                <div class="admin__field-control">
                    <input type="checkbox" id="mk-has_patent" name="seller[has_patent]" value="1"
                           class="admin__control-checkbox" <?= $block->value('has_patent') === '1' ? 'checked' : '' ?>/>
                    <label for="mk-has_patent" class="admin__field-label"><span><?= $escaper->escapeHtml(__('The seller holds a business licence')) ?></span></label>
                </div>
            </div>
        </div>

        <div class="admin__field">
            <label class="admin__field-label" for="mk-description"><span><?= $escaper->escapeHtml(__('Shop description')) ?></span></label>
            <div class="admin__field-control">
                <textarea id="mk-description" name="seller[description]" class="admin__control-textarea"><?= $escaper->escapeHtml($block->value('description')) ?></textarea>
            </div>
        </div>
    </fieldset>

    <div class="mk-actions">
        <button type="submit" class="action-default action-primary"><?= $escaper->escapeHtml(__('Save')) ?></button>
        <a class="action-default" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>"><?= $escaper->escapeHtml(__('Back to the list')) ?></a>
    </div>
</form>
