<?php
/** @var \Mytek\Marketplace\Block\Adminhtml\Seller\Form $block */
$s = $block->getSeller();
$governorates = $block->getGovernorates();
$currentGov = $block->value('governorate');
if ($currentGov !== '' && !in_array($currentGov, $governorates, true)) {
    $governorates[] = $currentGov;
}
$textFields = [
    'firstname'      => ['Prénom', true, 'text'],
    'lastname'       => ['Nom', true, 'text'],
    'email'          => ['Email', true, 'email'],
    'contact_number' => ['Téléphone', true, 'text'],
    'shop_title'     => ['Nom du magasin (enseigne)', true, 'text'],
    'company'        => ['Société', false, 'text'],
    'address'        => ['Adresse', false, 'text'],
    'zipcode'        => ['Code postal', false, 'text'],
    'tax_id'         => ['Matricule fiscal (Tax ID)', false, 'text'],
];
?>
<form method="post" action="<?= $block->escapeUrl($block->getSaveUrl()) ?>" class="mk-form">
    <input type="hidden" name="form_key" value="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>"/>

    <fieldset class="admin__fieldset">
        <legend class="admin__legend"><span>Informations du vendeur</span></legend>
        <p class="mk-readonly">
            ID #<?= (int)($s['seller_id'] ?? 0) ?> —
            Statut : <?= $block->escapeHtml($block->statusLabel()) ?> —
            Inscrit le <?= $block->escapeHtml((string)($s['created_at'] ?? '')) ?>
            (le statut se modifie depuis la liste des vendeurs, le mot de passe n'est jamais modifiable ici)
        </p>

        <div class="mk-grid-2">
            <?php foreach ($textFields as $name => [$label, $required, $type]): ?>
                <div class="admin__field <?= $required ? '_required' : '' ?>">
                    <label class="admin__field-label" for="mk-<?= $name ?>"><span><?= $block->escapeHtml($label) ?></span></label>
                    <div class="admin__field-control">
                        <input type="<?= $type ?>" id="mk-<?= $name ?>" name="seller[<?= $name ?>]"
                               class="admin__control-text" <?= $required ? 'required' : '' ?>
                               value="<?= $block->escapeHtmlAttr($block->value($name)) ?>"/>
                    </div>
                </div>
            <?php endforeach; ?>

            <div class="admin__field">
                <label class="admin__field-label" for="mk-governorate"><span>Gouvernorat</span></label>
                <div class="admin__field-control">
                    <select id="mk-governorate" name="seller[governorate]" class="admin__control-select">
                        <option value="">— Non renseigné —</option>
                        <?php foreach ($governorates as $g): ?>
                            <option value="<?= $block->escapeHtmlAttr($g) ?>" <?= $g === $currentGov ? 'selected' : '' ?>><?= $block->escapeHtml($g) ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
            </div>

            <div class="admin__field">
                <label class="admin__field-label" for="mk-has_patent"><span>Patente commerciale</span></label>
                <div class="admin__field-control">
                    <input type="checkbox" id="mk-has_patent" name="seller[has_patent]" value="1"
                           class="admin__control-checkbox" <?= $block->value('has_patent') === '1' ? 'checked' : '' ?>/>
                    <label for="mk-has_patent" class="admin__field-label"><span>Le vendeur possède une patente</span></label>
                </div>
            </div>
        </div>

        <div class="admin__field">
            <label class="admin__field-label" for="mk-description"><span>Description de la boutique</span></label>
            <div class="admin__field-control">
                <textarea id="mk-description" name="seller[description]" class="admin__control-textarea"><?= $block->escapeHtml($block->value('description')) ?></textarea>
            </div>
        </div>
