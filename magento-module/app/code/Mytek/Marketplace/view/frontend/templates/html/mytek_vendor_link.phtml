<?php
/** Lien « Espace Vendeur » de l'en-tête, vers l'espace vendeur (adresse configurable). */
/** @var \Mytek\Marketplace\Block\VendorSpaceLink $block */
/** @var \Magento\Framework\Escaper $escaper */
$url = $block->getVendorSpaceUrl();
if ($url === '') {
    return;
}
?>
<a href="<?= $escaper->escapeUrl($url) ?>" class="mk-espace-vendeur-link" target="_blank" rel="noopener">
    <?= $escaper->escapeHtml(__('Seller space')) ?>
</a>
