<?php
/** @var \Mytek\Marketplace\Block\Seller\Link $block */
/** @var \Magento\Framework\Escaper $escaper */
$seller = $block->getSeller();
if (!$seller) {
    return;
}
?>
<div class="mk-seller-link">
    <?= $escaper->escapeHtml(__('Seller:')) ?>
    <a href="<?= $escaper->escapeUrl($block->getShopUrl((int)$seller['seller_id'])) ?>">
        <?= $escaper->escapeHtml($seller['shop_title']) ?>
    </a>
    <?php if ((int)$seller['has_patent'] === 1): ?>
        <span class="mk-seller-link__verified">&#10003; <?= $escaper->escapeHtml(__('Verified')) ?></span>
    <?php endif; ?>
</div>
