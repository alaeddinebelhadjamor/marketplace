<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Toutes les 15 minutes : tient seller_governorate à jour sans jointure entre les
             deux bases (ch. 2 § 2.2.3, amélioration B). -->
        <job name="mytek_marketplace_sync_seller_governorate" instance="Mytek\Marketplace\Cron\SyncSellerGovernorate" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <!-- Filet de sécurité : l'observateur ReindexProductOnSave met déjà à jour l'index
             marketplace à chaque enregistrement de produit (amélioration J). -->
        <job name="mytek_marketplace_rebuild_opensearch_index" instance="Mytek\Marketplace\Cron\RebuildOpenSearchIndex" method="execute">
            <schedule>0 * * * *</schedule>
        </job>
    </group>
</config>
