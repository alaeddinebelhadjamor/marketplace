<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Mytek_Marketplace::marketplace" title="Marketplace" translate="title" sortOrder="35">
                    <resource id="Mytek_Marketplace::dashboard" title="Marketplace dashboard" translate="title" sortOrder="10"/>
                    <resource id="Mytek_Marketplace::sellers" title="Sellers" translate="title" sortOrder="20">
                        <resource id="Mytek_Marketplace::sellers_edit" title="Edit a seller" translate="title" sortOrder="10"/>
                        <resource id="Mytek_Marketplace::sellers_validate" title="Approve or refuse a seller" translate="title" sortOrder="20"/>
                        <resource id="Mytek_Marketplace::sellers_delete" title="Delete a seller" translate="title" sortOrder="30"/>
                    </resource>
                    <resource id="Mytek_Marketplace::reclamations" title="Seller claims" translate="title" sortOrder="30"/>
                    <resource id="Mytek_Marketplace::notifications" title="Send a notification" translate="title" sortOrder="25"/>
                    <!-- Réservé à l'administrateur (ch. 2 § 2.1 : supervision des aspects financiers) ;
                         non accordé à l'intégrateur. -->
                    <resource id="Mytek_Marketplace::commissions" title="Commissions and payout statements" translate="title" sortOrder="50"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Mytek_Marketplace::config" title="Mytek Marketplace configuration" translate="title" sortOrder="90"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
