# Marketplace Mytek v2 — modèle de configuration.
# Copier en .env puis renseigner les valeurs (jamais versionnées).
# Raccourci : php8.4 ../scripts/importer-env-v1.php <.env de la v1> .env

APP_NAME="Marketplace Mytek v2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Application Vue autorisée (CORS + cookie de session Sanctum)
FRONTEND_URL=http://localhost:5180
SANCTUM_STATEFUL_DOMAINS=localhost:5180,127.0.0.1:5180
CORS_EXTRA_ORIGINS=

# Base marketplace existante (conteneur marketplace-mysql)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=mk_database_prod_restored
DB_USERNAME=
DB_PASSWORD=
DB_COLLATION=utf8mb4_0900_ai_ci

# Sessions, cache et file d'attente en base (pas de Redis)
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Clé des routes d'administration (en-tête x-admin-key)
ADMIN_API_KEY=

# Magento (API REST) et site public
MAGENTO_URL=http://localhost:8080
MAGENTO_USER=
MAGENTO_PASSWORD=
STOREFRONT_URL=http://localhost:8080

# OpenSearch
OPENSEARCH_BASE_URL=http://localhost:9201

# Suivi comportemental (journal Apache de Magento). Laisser à false tant que la v1 lit le même journal.
BEHAVIOR_SYNC_ENABLED=false
MAGENTO_ACCESS_LOG=
MAGENTO_LOG_OFFSET_FILE=storage/app/private/magento_log_offset.json
# Pièces jointes de la v1, relues en lecture seule (optionnel)
LEGACY_UPLOADS_DIR=

# Tâches planifiées (format cron)
CRON_ORDERS_SYNC="* * * * *"
CRON_PRODUCT_VIEWS="* * * * *"
SCHEDULE_TIMEZONE=Europe/Paris

# Commission par défaut (5 %)
COMMISSION_RATE=0.05

# Temps réel (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8091
REVERB_SERVER_PORT=8091
REVERB_SCHEME=http

# Emails (mot de passe oublié). « log » écrit les emails dans storage/logs.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@mytek.tn
MAIL_FROM_NAME="Mytek Marketplace"
