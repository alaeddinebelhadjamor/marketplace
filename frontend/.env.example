# Espace vendeur v2 — copier en .env (non versionné).
# Adresse de l'API Laravel
VITE_API_URL=http://localhost:8010
# Temps réel (Laravel Reverb) : clé publique de l'application Reverb (REVERB_APP_KEY du backend)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8091
VITE_REVERB_SCHEME=http
